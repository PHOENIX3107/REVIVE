POSTGRES_USER=revive
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=revive
DATABASE_URL=postgresql://revive:replace_with_local_password@localhost:5432/revive
REDIS_URL=redis://localhost:6379/0
REVIVE_API_BASE_URL=http://127.0.0.1:8000
REVIVE_FRONTEND_PORT=3000
REVIVE_RECONCILIATION_POLL_INTERVAL_SECONDS=60
REVIVE_RECONCILIATION_BATCH_SIZE=50
REVIVE_RECONCILIATION_RETRY_ATTEMPTS=3
REVIVE_RECONCILIATION_RETRY_BACKOFF_SECONDS=1
REVIVE_RECONCILIATION_RETRY_MAX_BACKOFF_SECONDS=30
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_mode_key_secret
# Optional compatibility path; polling does not require this secret.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
AI_PROVIDER=your_provider_name
AI_API_KEY=your_provider_api_key
